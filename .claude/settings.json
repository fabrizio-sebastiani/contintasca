{
  "permissions": {
    "allow": [
      "Bash(mvn:*)",
      "Bash(npx:*)",
      "Bash(npm:*)",
      "Bash(curl:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Read(./**/secrets/**)",
      "Edit(./**/secrets/**)"
    ]
  }
}
